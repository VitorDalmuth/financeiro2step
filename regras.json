{
  "rules": {
    "2step_financeiro": {
      "usuarios": {
        ".read": "auth != null",
        ".write": "!root.child('2step_financeiro/usuarios').exists() || root.child('2step_financeiro/usuarios').child(auth.token.email.toLowerCase().replace('.', ',')).child('papel').val() === 'admin'"
      },
      "clientes": {
        ".read": "auth != null",
